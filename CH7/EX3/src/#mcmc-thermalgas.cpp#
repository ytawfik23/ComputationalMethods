#include "QatDataAnalysis/Hist1D.h"
#include "QatPlotting/PlotHist1D.h"

#include "QatGenericFunctions/Variable.h"
#include "QatGenericFunctions/Exp.h"
#include "QatPlotting/PlotFunction1D.h"

#include "QatPlotWidgets/PlotView.h"
#include "QatPlotWidgets/setLightPalette.h"
#include "QatPlotting/PlotStream.h"
#include <QApplication>
#include <QMainWindow>
#include <QToolBar>
#include <QAction>
#include <cstdlib>
#include <iostream>
#include <string>
#include <random>
#include <algorithm>

typedef std::mt19937 EngineType;

int main (int argc, char * * argv) {


  std::string usage= std::string("usage: ") + argv[0]; 
  if (argc!=1) {
    std::cout << usage << std::endl;
  }
  //===================================================
                      //Main Program
  //===================================================

  //Initializing The histogram
  int NumBins = 100;
  double umin = 0.0;
  double umax = 5.0;
  double BinSpacing = (umax - umin)/NumBins;
  Hist1D hx ("X", NumBins, umin, umax);

  //Initializing MCMC
  int NStates = 1000000;
  EngineType e;
  double SIGMA = 0.5;
  std::normal_distribution<double>       gauss(0.0, SIGMA);
  std::uniform_real_distribution<double> flat(0.0, 1.0);
  int accepted = 0;

  Genfun::Variable U2;
  Genfun::GENFUNCTION rhoNorm =  sqrt(2.0/M_PI) * Genfun::Exp()(-U2/2.0);

  std::vector<double> v = {0.0, 0.0, 0.0};
  double v_norm = 0;
  double Prob_v = 1;

  //MCMC loop
  for(int i=0; i<NStates; i++){
    //propose a new velocity
    std::vector<double> v_new = v;
    for(int j=0; j<3; j++) {v_new[j] += gauss(e);}
    double v_new_norm = v_new[0]*v_new[0] + v_new[1]*v_new[1] + v_new[2]*v_new[2];
    double Prob_v_new = rhoNorm(v_new_norm);

    //accept or reject the new velocity
    if(flat(e) < std::min(1.0,Prob_v_new/Prob_v)) {v = v_new; v_norm = v_new_norm; Prob_v = Prob_v_new; accepted+=1;}

    //add new velocity to histogram
    hx.accumulate(sqrt(v_norm));
  }

  // Plot the velocity distribution function rho(u)
  Genfun::Variable U;
  Genfun::GENFUNCTION rho = NStates* BinSpacing * sqrt(2.0/M_PI) * U*U * Genfun::Exp()(-U*U/2.0);


  std::cout << static_cast<double>(accepted)/static_cast<double>(NStates) << std::endl;
  //===================================================
                      //Windowing
  //===================================================
  QApplication     app(argc,argv);
  setLightPalette();
  
  QMainWindow window;
  QToolBar *toolBar=window.addToolBar("Tools");
  QAction  *quitAction=toolBar->addAction("Quit");
  
  quitAction->setShortcut(QKeySequence("q"));
  
  QObject::connect(quitAction, &QAction::triggered, &app, &QApplication::quit);
  
  //===================================================
                      //Plotting
  //===================================================

  PlotHist1D pH=hx;
  PlotView view(pH.rectHint());

  PlotFunction1D prho{rho};

  view.add(&prho);
  view.add(&pH);

  view.yAxisFont().setPointSize(12);
  window.setCentralWidget(&view);

  std::string title = "Thermal Distribution";
  
  PlotStream titleStream(view.titleTextEdit());
  titleStream << PlotStream::Clear()
	      << PlotStream::Center() 
	      << PlotStream::Family("Sans Serif") 
	      << PlotStream::Size(16)
	      << title
	      << PlotStream::EndP();
  
  
  PlotStream xLabelStream(view.xLabelTextEdit());
  xLabelStream << PlotStream::Clear()
	       << PlotStream::Center()
	       << PlotStream::Family("Sans Serif")
	       << PlotStream::Size(16)
	       << "u" 
	       << PlotStream::EndP();
  
  PlotStream yLabelStream(view.yLabelTextEdit());
  yLabelStream << PlotStream::Clear()
	       << PlotStream::Center()
	       << PlotStream::Family("Sans Serif")
	       << PlotStream::Size(16)
	       << "ρ"
	       << "(u)"
	       << PlotStream::EndP();
  
  
  window.show();
  app.exec();
  return 1;
}

